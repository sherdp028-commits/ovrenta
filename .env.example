# --- ВКонтакте ---
# Ключ доступа сообщества (Управление → Работа с API → Ключи доступа),
# нужны права «Управление сообществом» и «Сообщения сообщества».
VK_TOKEN=
# Числовой ID сообщества, например 123456789 (можно и в виде club123456789).
VK_GROUP_ID=

# --- Claude ---
# Ключ API Anthropic: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# --- Необязательные настройки (ниже значения по умолчанию) ---
# Модель Claude.
# BOT_MODEL=claude-opus-5-5
# Насколько глубоко модель думает перед ответом: low, medium, high, xhigh, max.
# low — быстрее и дешевле, high и выше — для сложных вопросов.
# BOT_EFFORT=medium
# Максимальная длина ответа в токенах (включая размышления модели).
# BOT_MAX_TOKENS=16000
# Сколько последних сообщений помнить в каждом диалоге.
# HISTORY_MAX_MESSAGES=40
# Файл с инструкцией для бота (его характер, тема, ограничения).
# SYSTEM_PROMPT_FILE=system_prompt.txt
# Подробность логов: DEBUG, INFO, WARNING.
# LOG_LEVEL=INFO
